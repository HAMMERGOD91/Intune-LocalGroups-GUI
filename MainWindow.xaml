<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune Local Groups | WPF v2.2" Width="1180" Height="920"
        MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Foreground="#172B44">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="BorderBrush" Value="#CAD4E0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Background" Value="#E8EEF6"/><Setter Property="Foreground" Value="#172B44"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="BorderBrush" Value="#E0E7EF"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="RDP Expanded Groups" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Microsoft Intune · Resolve groups, review membership, then apply." Foreground="#566980" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Microsoft account" FontSize="17" FontWeight="SemiBold"/>
        <Grid x:Name="AuthInputs" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Tenant ID (optional for standard sign-in)"/><TextBox x:Name="TenantBox"/></StackPanel>
        </Grid>
        <WrapPanel>
          <Button x:Name="InstallButton" Content="Install / repair module"/>
          <Button x:Name="ConnectButton" Content="Sign in / switch account" Background="#1463D6" Foreground="White"/>
          <Button x:Name="DisconnectButton" Content="Sign out"/>
        </WrapPanel>
        <TextBlock x:Name="AccountText" Text="Not connected" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#566980"/>
      </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="White" BorderBrush="#E0E7EF">
      <TabItem Header="1 · Configure" x:Name="ConfigureTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PolicyInputs" Margin="20">
            <Expander Header="Search COE groups (Graph)" Margin="0,0,0,16">
              <StackPanel x:Name="SearchPanel">
                <TextBlock Text="Partial search (format COE-&lt;dept&gt;-MG-...): ece-mg-baas or *ece-mg-baas* matches COE-ECE-MG-Research-Baas-Admins. Use ece-dg-baas for device groups." TextWrapping="Wrap"/>
                <TextBox x:Name="SearchBox"/><Button x:Name="SearchButton" Content="Search groups"/>
                <ListBox x:Name="GroupResults" SelectionMode="Extended" DisplayMemberPath="Label" Height="120" Margin="0,10"/>
                <TextBlock Text="MG + -Admins → Administrators | Other MG → Users and RDP | DG → Device targets" TextWrapping="Wrap" Margin="0,8"/><Button x:Name="AddGroupButton" Content="Add selected groups automatically" Margin="0,10,0,0"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="Policy name"/><TextBox x:Name="NameBox" Text="" ToolTip="Generated from MG or DG names. You can edit it if needed."/>
            <TextBlock Text="Description"/><TextBox x:Name="DescriptionBox" Text="Created using a PowerShell GUI. Manages local Administrators, Users, and Remote Desktop Users through Entra ID groups."/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Existing built-in local administrator name"/><TextBox x:Name="AdminBox" Text="coeit" IsReadOnly="True"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Scope tag"/><TextBox x:Name="TagBox" Text="COE" IsReadOnly="True"/></StackPanel>
            </Grid>
            <TextBlock Text="Enter one exact Entra group display name per line." Foreground="#566980" Margin="0,4,0,12"/>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,10,0"><TextBlock Text="Administrators source groups" FontWeight="SemiBold"/><TextBox x:Name="AdminGroupsBox" Height="110" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
              <StackPanel Margin="10,0,0,0"><TextBlock Text="Users source groups" FontWeight="SemiBold"/><TextBox x:Name="UserGroupsBox" Height="110" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="Remote Desktop source groups" FontWeight="SemiBold"/><TextBox x:Name="RdpGroupsBox" Height="110" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
              <StackPanel Margin="10,0,0,0"><TextBlock Text="Device target groups" FontWeight="SemiBold"/><TextBox x:Name="TargetsBox" Height="110" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel>
            </UniformGrid>
            <Border Background="#FFF4DB" Padding="12" CornerRadius="6"><TextBlock TextWrapping="Wrap" Foreground="#795210" Text="Replace membership: this policy replaces Administrators, Users, and Remote Desktop Users membership. Verify the built-in administrator name on every target. Empty RDP sources clear that group's membership."/></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Existing policies">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ExistingPanel" Margin="20">
          <TextBlock Text="Edit dedicated LocalUsersAndGroups custom XML policies. Other Intune profile types are not supported here." TextWrapping="Wrap"/>
          <Button x:Name="ListPoliciesButton" Content="List custom policies" Margin="0,10"/>
          <ComboBox x:Name="PolicyList" DisplayMemberPath="Label"/>
          <Button x:Name="LoadPolicyButton" Content="Load selected policy" Margin="0,10"/>
          <TextBlock Text="Policy name"/><TextBox x:Name="EditNameBox"/>
          <TextBlock Text="Description"/><TextBox x:Name="EditDescriptionBox"/>
          <TextBlock Text="Membership XML — existing RDP source group names cannot be recovered from expanded user SIDs." TextWrapping="Wrap"/>
          <TextBox x:Name="EditXmlBox" Height="260" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="2 · Review" x:Name="ReviewTab">
        <TextBox x:Name="PreviewBox" Margin="16" IsReadOnly="True" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Resolve and preview to review the policy and XML before applying."/>
      </TabItem>
      <TabItem Header="Activity" x:Name="ActivityTab">
        <TextBox x:Name="ActivityBox" Margin="16" IsReadOnly="True" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <ProgressBar x:Name="BusyBar" Height="3" Visibility="Collapsed" IsIndeterminate="True" Margin="0,0,0,10"/>
      <DockPanel>
        <Button x:Name="LogsButton" Content="Open logs" DockPanel.Dock="Right" Margin="10,0,0,0"/>
        <WrapPanel>
          <Button x:Name="PreviewButton" Content="Resolve and preview"/>
          <Button x:Name="PreviewEditButton" Content="Preview existing edit"/><Button x:Name="SaveEditButton" Content="Save existing policy" IsEnabled="False"/><Button x:Name="ApplyButton" Content="Apply policy" Background="#1463D6" Foreground="White" IsEnabled="False"/>
        </WrapPanel>
      </DockPanel>
      <TextBlock x:Name="StatusText" Text="Ready" Margin="0,10,0,0" Foreground="#566980" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
